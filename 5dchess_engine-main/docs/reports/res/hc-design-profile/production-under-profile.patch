+namespace hc_detail
+{
+// Preserve HC and piece order, including the selected HC's remaining pieces
+// at the back. Global problems need intersection-aware removal on every HC.
+inline void propagate_globally(search_space &space, const HC &selected,
+                               const slice &problem)
+{
+    search_space remaining;
+    for(const HC &hc : space)
+        remaining.concat(hc.remove_slice_carefully(problem));
+    remaining.concat(selected.remove_slice_carefully(problem));
+    space = std::move(remaining);
+}
